# Cloudflare Turnstile
# Create a widget at https://dash.cloudflare.com/ → Turnstile
# Add your production domain (and localhost for local testing).

# Public site key (safe in frontend; baked in at build time)
VITE_TURNSTILE_SITE_KEY=your_site_key_here

# Secret key goes only in public/api/contact.php as $turnstileSecret
# (never put the secret in this file for production builds that ship to the browser)
